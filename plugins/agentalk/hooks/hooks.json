{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:2026/hook/claude", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:2026/hook/claude", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:2026/hook/claude", "timeout": 5 }
        ]
      }
    ]
  }
}
